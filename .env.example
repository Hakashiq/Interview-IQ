# ==============================================================================
# InterviewIQ - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure the variables for your environment.

# ------------------------------------------------------------------------------
# Google Gemini API
# ------------------------------------------------------------------------------
# Required for AI questions, resume parsing, ATS scoring, and evaluation.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# MySQL Database Configuration
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=interviewiq
MYSQL_USER=root
MYSQL_PASSWORD=root123
# For local run: jdbc:mysql://localhost:3306/interviewiq?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
# For docker-compose: jdbc:mysql://mysql:3306/interviewiq?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/interviewiq?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root123

# ------------------------------------------------------------------------------
# Redis Cache Configuration
# ------------------------------------------------------------------------------
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Backend & AI Service Communication
# ------------------------------------------------------------------------------
# Inside Docker network: http://ai-service:8000
# For local host run: http://localhost:8000
AI_SERVICE_URL=http://ai-service:8000

# ------------------------------------------------------------------------------
# Security & JWT Configuration
# ------------------------------------------------------------------------------
# 256-bit or 512-bit hex secret key for signing JWT tokens
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970337336763979244226452948404D6351655468576D5A7134743777217A25432A46

# ------------------------------------------------------------------------------
# CORS Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ------------------------------------------------------------------------------
# Frontend Client Configuration
# ------------------------------------------------------------------------------
# API base URL for the React SPA.
# When running behind Nginx: /api
# When running frontend standalone: http://localhost:8080/api
VITE_API_URL=http://localhost:8080/api
